# Copy to `.env` (or `.env.local`) and adjust if your backend is not on :3000.
#
# Leave VITE_API_BASE_URL as a relative path in development: the Vite dev server
# proxies /api to VITE_PROXY_TARGET, so the browser makes a same-origin request
# and CORS never enters the picture.
VITE_API_BASE_URL=/api/v1

# Where the dev-server proxy forwards /api. This is the backend's own URL.
VITE_PROXY_TARGET=http://localhost:3000

# For a production build, point the base URL straight at the deployed API and
# make sure that origin is listed in the backend's CORS_ORIGINS:
#   VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
